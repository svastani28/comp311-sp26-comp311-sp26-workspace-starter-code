        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>opcode funct3 funct7 ALUOperation ImmSrc ALUSrc RegWrite

# ----------- R-Type tests (opcode = 0b0110011)-----------

#add
0b0110011 0b000 0b0000000 0b0010 0b00 0b0 0b1
#sub
0b0110011 0b000 0b0100000 0b0110 0b00 0b0 0b1
#and
0b0110011 0b111 0b0000000 0b0000 0b00 0b0 0b1
#or
0b0110011 0b110 0b0000000 0b0001 0b00 0b0 0b1
#slt
0b0110011 0b010 0b0000000 0b0111 0b00 0b0 0b1

#----------- I-type ALU (opcode = 0010011)-----------

#addi
0b0010011 0b000 0b0000000 0b0010 0b00 0b1 0b1
#slti
0b0010011 0b010 0b0000000 0b0111 0b00 0b1 0b1
#andi
0b0010011 0b111 0b0000000 0b0000 0b00 0b1 0b1</dataString>
          </testData>
        </entry>
